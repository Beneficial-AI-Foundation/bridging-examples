+/-!
+# `rand_core::TryRngCore` and `rand_core::UnwrapErr`
+
+`UnwrapErr` turns a fallible RNG into an infallible one, which panics upon failure:
+`OsRng.unwrap_err().fill_bytes(..)` returns random bytes, or panics.
+-/
+
+/-- A wrapper around a fallible RNG, which panics upon failure. -/
+@[reducible, expose, rust_type "rand_core::UnwrapErr"]
+def rand_core.UnwrapErr (R : Type u) (_Error : Type v) := R
+
+@[rust_trait "rand_core::TryRngCore"
+  (parentClauses := ["corefmtDebugInst", "corefmtDisplayInst"])
+  (defaultMethods := ["unwrap_err"])]
+structure rand_core.TryRngCore (Self : Type u) (Self_Error : Type v) where
+  corefmtDebugInst : core.fmt.Debug Self_Error
+  corefmtDisplayInst : core.fmt.Display Self_Error
+  try_next_u32 : Self → Result ((core.result.Result U32 Self_Error) × Self)
+  try_next_u64 : Self → Result ((core.result.Result U64 Self_Error) × Self)
+  try_fill_bytes : Self → Slice U8 →
+    Result ((core.result.Result Unit Self_Error) × Self × (Slice U8))
+  unwrap_err : Self → Result (rand_core.UnwrapErr Self Self_Error) := fun self => ok self
+
+@[expose, trait_default]
+def rand_core.TryRngCore.unwrap_err.default {Self : Type u} {Error : Type v}
+    (_TryRngCoreInst : rand_core.TryRngCore Self Error) (self : Self) :
+    Result (rand_core.UnwrapErr Self Error) :=
+  ok self
+
+@[expose, rust_fun
+  "rand_core::{rand_core::RngCore<rand_core::UnwrapErr<@R, @Clause0_Error>>}::next_u32"]
+def rand_core.UnwrapErr.next_u32 {R : Type u} {Error : Type v}
+    (TryRngCoreInst : rand_core.TryRngCore R Error) (self : rand_core.UnwrapErr R Error) :
+    Result (U32 × rand_core.UnwrapErr R Error) :=
+  Std.bind (TryRngCoreInst.try_next_u32 self) fun (r, self) =>
+  match r with
+  | .Ok x => ok (x, self)
+  | .Err _ => fail .panic
+
+@[expose, rust_fun
+  "rand_core::{rand_core::RngCore<rand_core::UnwrapErr<@R, @Clause0_Error>>}::next_u64"]
+def rand_core.UnwrapErr.next_u64 {R : Type u} {Error : Type v}
+    (TryRngCoreInst : rand_core.TryRngCore R Error) (self : rand_core.UnwrapErr R Error) :
+    Result (U64 × rand_core.UnwrapErr R Error) :=
+  Std.bind (TryRngCoreInst.try_next_u64 self) fun (r, self) =>
+  match r with
+  | .Ok x => ok (x, self)
+  | .Err _ => fail .panic
+
+@[expose, rust_fun
+  "rand_core::{rand_core::RngCore<rand_core::UnwrapErr<@R, @Clause0_Error>>}::fill_bytes"]
+def rand_core.UnwrapErr.fill_bytes {R : Type u} {Error : Type v}
+    (TryRngCoreInst : rand_core.TryRngCore R Error) (self : rand_core.UnwrapErr R Error)
+    (dst : Slice U8) :
+    Result (rand_core.UnwrapErr R Error × Slice U8) :=
+  Std.bind (TryRngCoreInst.try_fill_bytes self dst) fun (r, self, dst) =>
+  match r with
+  | .Ok _ => ok (self, dst)
+  | .Err _ => fail .panic
+
+end Aeneas.Std
